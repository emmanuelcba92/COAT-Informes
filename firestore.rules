rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función para verificar si es administrador
    function isAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.lower() == 'administrador') ||
        request.auth.token.email.lower() == 'egomez@coat.com.ar' ||
        request.auth.token.email.lower() == 'aparedes@coat.com.ar'
      );
    }

    // Usuarios
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (
        isAdmin() || 
        (request.auth.uid == userId && 
         (request.resource.data.get('role', 'profesional') == (resource == null ? 'profesional' : resource.data.get('role', 'profesional')))
        )
      );
      allow delete: if request.auth != null && isAdmin();
    }

    // Historial de Informes
    match /reports_history/{reportId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // Prácticas
    match /practices/{practiceId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Configuración
    match /config/{configId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
