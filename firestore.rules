rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función para verificar si es administrador
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.lower() == 'administrador';
    }

    // Colección de Usuarios
    match /users/{userId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow create, delete, write: if isAdmin();
    }

    // Colección de Auditoría (INMUTABLE)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if false; // Bloqueo total de edición/borrado
    }

    // Colección de Pacientes, Informes y Pedidos (Accesible por staff logueado)
    match /patients/{id} { allow read, write: if request.auth != null; }
    match /reports/{id} { allow read, write: if request.auth != null; }
    match /orders/{id} { allow read, write: if request.auth != null; }

    // Colección de Prácticas
    match /practices/{practiceId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Ajustes Globales
    match /config/{configId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}