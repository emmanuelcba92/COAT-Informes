rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función simple de rol
    function hasRole(roleName) {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null && (
        (userData.role != null && userData.role.lower() == roleName.lower()) ||
        (userData.r != null && userData.r.lower() == roleName.lower()) ||
        (userData.role != null && userData.role.lower() == 'admin') ||
        (userData.r != null && userData.r.lower() == 'admin')
      );
    }

    function isAdmin() {
      let email = request.auth.token.email.lower();
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null && (
        (userData.role != null && userData.role.lower() == 'admin') ||
        (userData.r != null && userData.r.lower() == 'admin') ||
        (userData.role != null && userData.role.lower() == 'administrador') ||
        email == 'egomez@coat.com.ar' ||
        email == 'aparedes@coat.com.ar'
      );
    }

    // Usuarios
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // Prácticas
    match /practices/{practiceId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // INFORMES
    match /reports/{reportId} {
      allow read, delete: if isAdmin() || hasRole('secretaría') || hasRole('secretaria');
      allow read, delete: if request.auth != null && resource.data.profesionalId == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if isAdmin() || (request.auth != null && resource.data.profesionalId == request.auth.uid);
    }

    // Configuración
    match /config/{configId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
